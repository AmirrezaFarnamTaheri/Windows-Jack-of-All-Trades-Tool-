<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>SystemMaintenance.Tests.TestRunner</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MaintenanceToolkit/source/Core/ScriptExecutor.cs" />
    <Compile Include="MaintenanceToolkit/source/Core/SystemStatsService.cs" />
    <Compile Include="MaintenanceToolkit/source/Core/ConfigManager.cs" />
    <Compile Include="MaintenanceToolkit/source/Models/*.cs" />
    <Compile Include="MaintenanceToolkit/source/Tests/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>
</Project>
